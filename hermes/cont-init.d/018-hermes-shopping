#!/command/with-contenv sh
# Render $HERMES_HOME/config.yaml from the environment on every start, so the
# container stays declarative: edit .env, restart, done.
#
# This used to be an ENTRYPOINT script. The official image hands PID 1 to
# s6-overlay, which supervises the gateway and the dashboard, so we hook the
# init sequence instead of replacing it. The number is load-bearing: s6 runs
# /etc/cont-init.d/* in lexical order, and this has to land after
# `01-hermes-setup` (the UID remap and data-volume chown — so the files we
# write can be handed to the final hermes UID) but before `02-reconcile-
# profiles`, which restarts gateways that were running at shutdown and must
# not come up against last boot's config.
set -eu

HERMES_DIR="${HERMES_HOME:-/opt/data}"
mkdir -p "$HERMES_DIR"

LLM_BASE_URL="${LLM_BASE_URL:?set LLM_BASE_URL, e.g. http://10.150.0.30:1234/v1}"
LLM_MODEL="${LLM_MODEL:?set LLM_MODEL}"
LLM_API_KEY="${LLM_API_KEY:-local}"
PRICEWATCH_MCP_URL="${PRICEWATCH_MCP_URL:-http://pricewatch:8000/mcp}"
# Declare the model's real window (Hermes refuses anything under 64K), but cap the
# output request: left to itself Hermes asks for max_tokens == context_length, and
# vLLM requires prompt + max_tokens <= max_model_len, so every call would fail once
# and retry. LLM_MAX_TOKENS keeps each request inside the window on the first try.
LLM_CONTEXT_LENGTH="${LLM_CONTEXT_LENGTH:-65536}"
LLM_MAX_TOKENS="${LLM_MAX_TOKENS:-8192}"
# Dashboard skin: a built-in (default, midnight, ember, mono, cyberpunk, rose) or
# the `name:` of any YAML in hermes/dashboard-themes/ (boring-dark, boring-light).
HERMES_DASHBOARD_THEME="${HERMES_DASHBOARD_THEME:-default}"

cat > "$HERMES_DIR/config.yaml" <<YAML
# Generated by cont-init.d/018-hermes-shopping — edit .env and restart rather
# than editing this file.

# The schema version this file is written against. Without it Hermes reads the
# config as v0, which is below the v12 auto-migration floor: it refuses to
# migrate and every load prints "config predates version 12". Bump this
# alongside the FROM tag in the Dockerfile — a stale-but-supported number is
# fine (Hermes migrates forward from it and says so), a missing one is not.
# \`hermes doctor\` reports the version it wants under "Configuration Files".
_config_version: 39

model:
  provider: custom
  default: ${LLM_MODEL}
  base_url: ${LLM_BASE_URL}
  api_key: ${LLM_API_KEY}
  context_length: ${LLM_CONTEXT_LENGTH}
  max_tokens: ${LLM_MAX_TOKENS}
  timeout: 300

mcp_servers:
  pricewatch:
    transport: http
    url: ${PRICEWATCH_MCP_URL}
    enabled: true
    timeout: 120

dashboard:
  theme: ${HERMES_DASHBOARD_THEME}
YAML

# Ship the shopping skill into the agent's skill directory.
if [ -d /opt/hermes-skills ]; then
  mkdir -p "$HERMES_DIR/skills"
  cp -r /opt/hermes-skills/. "$HERMES_DIR/skills/" 2>/dev/null || true
fi

# Ship dashboard themes where the web server scans for user themes. The switcher
# lists every *.yaml here alongside the built-ins; dashboard.theme above picks one.
if [ -d /opt/hermes-dashboard-themes ]; then
  mkdir -p "$HERMES_DIR/dashboard-themes"
  cp /opt/hermes-dashboard-themes/*.yaml "$HERMES_DIR/dashboard-themes/" 2>/dev/null || true
fi

# cont-init runs as root; everything past this point runs as the unprivileged
# `hermes` user (UID 10000, or whatever HERMES_UID remapped it to). Root-owned
# state in the agent home is this image's sharpest edge, and the image's own
# boot chown is deliberately targeted — a documented list of subdirectories,
# because a bind-mounted home may hold unrelated user files it must not claim.
# That is the right default upstream and the wrong one here: this volume is
# the agent's alone, and it was written by a container that ran hermes as root
# under /root/.hermes, so top-level state (SOUL.md, state.db, gateway/) came
# across root-owned. Hermes surfaces that as "Could not load config.yaml",
# because every config read goes through a SOUL.md write it cannot make.
#
# So claim the whole home, minus the workspace bind mount — that one is the
# host's, and the image already handles it.
find "$HERMES_DIR" -path "$HERMES_DIR/workspace" -prune -o \
  -exec chown hermes:hermes {} + 2>/dev/null || \
  echo "[hermes-shopping] warning: chown $HERMES_DIR failed — continuing" >&2

# The dashboard binds off loopback, and Hermes fails closed there without an auth
# provider. Warn rather than exit: the gateway and its cron ticker are in this
# container too, and they should not go down over a dashboard misconfiguration.
case "${HERMES_DASHBOARD:-}" in
  1|true|TRUE|True|yes|YES|Yes)
    if [ -z "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD:-}" ] && \
       [ -z "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH:-}" ] && \
       [ -z "${HERMES_DASHBOARD_OAUTH_CLIENT_ID:-}" ]; then
      echo "[hermes-shopping] WARNING: the dashboard has no auth provider, so it" >&2
      echo "[hermes-shopping] will refuse to serve. Set these in .env and re-run" >&2
      echo "[hermes-shopping] 'docker compose up -d hermes':" >&2
      echo "[hermes-shopping]   HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin" >&2
      echo "[hermes-shopping]   HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<choose one>" >&2
    fi
    ;;
esac
